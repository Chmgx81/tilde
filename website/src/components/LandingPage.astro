---
import DemoWorkflow from './DemoWorkflow.astro';

const installCommand = 'curl -fsSL https://raw.githubusercontent.com/Chmgx81/tilde/main/get.sh | sh';

const providers = [
  { name: 'Ollama', detail: 'Local models', slug: 'ollama' },
  { name: 'Anthropic', detail: 'Claude models', slug: 'anthropic' },
  { name: 'OpenAI', detail: 'GPT models', slug: 'openai' },
  { name: 'Gemini', detail: 'Google models', slug: 'gemini' },
  { name: 'OpenRouter', detail: 'Live catalogue', slug: 'openrouter' },
  { name: 'OpenCode', detail: 'Any provider', slug: 'opencode' },
];

const productWorkflow = {
  variant: 'product' as const,
  project: '~/payments-api · main',
  mode: 'working',
  request: 'Fix the double-charge bug in checkout',
  progress: '2 of 9',
  items: [
    { label: 'Create the issue', detail: 'Created GitHub issue #210', status: 'done' as const },
    { label: 'Create isolated branch', detail: 'Running git worktree add', status: 'done' as const },
    { label: 'Trace and fix the bugs', detail: 'Reading checkout/handler.go', status: 'active' as const },
    { label: 'Review the diff', detail: '' },
    { label: 'Run focused tests', detail: '' },
    { label: 'Open the pull request', detail: '' },
    { label: 'Watch CI and code review', detail: '' },
    { label: 'Address feedback', detail: '' },
    { label: 'Merge the change', detail: '' },
  ],
  agent: { glyph: '⎿', label: 'work', detail: 'creating a clean workspace for the fix' },
  proof: { command: 'go test ./... — 47 passed', elapsed: '12.4s' },
};

const agentWorkflow = {
  variant: 'agents' as const,
  coordinator: { task: 'Harden webhook verification', status: 'coordinator' },
  rows: [
    { number: '01', label: 'Trace request path', status: 'complete', statusClass: 'complete' },
    { number: '02', label: 'Check failure modes', status: 'working', statusClass: 'working' },
    { number: '03', label: 'Review test coverage', status: 'queued' },
  ],
  note: 'Depth, fan-out, runtime, and agent count stay capped.',
};

const tiers = [
  {
    slug: 'denied',
    glyph: '✗',
    name: 'deny',
    sub: 'never runs',
    desc: 'Blocked paths and patterns are hard limits that hold in every mode, including --yes. A denied action cannot be approved around.',
  },
  {
    slug: 'ask',
    glyph: '⚠',
    name: 'ask',
    sub: 'you decide',
    desc: 'The literal command appears with the reason for it — never a paraphrase. Answer y to run it once, n to refuse, or a for the rest of the session.',
  },
  {
    slug: 'allow',
    glyph: '✓',
    name: 'allow',
    sub: 'safe by default',
    desc: 'Reads, searches, and scoped edits inside the sandbox. The work that can move fast because it cannot hurt the repository or leave the machine.',
  },
];
---
<div class="tilde-home not-content">
  <section class="tilde-hero" aria-labelledby="tilde-title">
    <div class="tilde-hero-copy">
      <img
        class="tilde-hero-brand"
        src="/images/banner_hero_logo.png"
        alt="tilde (~)"
        width="1154"
        height="317"
        fetchpriority="high"
        decoding="async"
      />
      <p class="tilde-eyebrow">A terminal coding agent · Open source</p>
      <h1 id="tilde-title">Built for <em>real</em> engineering.</h1>
      <p class="tilde-hero-lede">
        tilde turns complex repo work into a visible workflow — plan, build, test, and ship from one terminal, with every risky step waiting for your say-so.
      </p>
      <div class="tilde-actions">
        <a class="tilde-button tilde-button-primary" href="https://github.com/Chmgx81/tilde">Install tilde</a>
        <a class="tilde-text-link" href="https://github.com/Chmgx81/tilde">View on GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <div class="tilde-install" role="group" aria-label="Install command">
        <span class="tilde-prompt" aria-hidden="true">~</span>
        <code>{installCommand}</code>
        <button type="button" data-copy-install data-command={installCommand} aria-label="Copy install command">
          <svg class="copy-icon" viewBox="0 0 20 20" aria-hidden="true"><rect x="6" y="6" width="10" height="10" rx="2"></rect><path d="M13 6V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h1"></path></svg>
          <svg class="check-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-9"></path></svg>
        </button>
        <span class="tilde-copy-status" data-copy-status aria-live="polite"></span>
      </div>
    </div>
    <div class="tilde-hero-workflow">
      <DemoWorkflow {...productWorkflow} />
    </div>
  </section>

  <section class="tilde-speed reveal" aria-labelledby="speed-title">
    <div class="tilde-speed-heading">
      <p class="tilde-label">Mechanics</p>
      <h2 id="speed-title">Less waiting. More useful work in motion.</h2>
      <p>
        tilde coordinates visible workflows and focused subagents. Independent reads, searches, and
        inspection subagents run concurrently while writes stay serial.
      </p>
    </div>
    <div class="tilde-speed-grid">
      <article>
        <div class="tilde-speed-card-meta"><span>01</span><small>Available now</small></div>
        <h3>Sandbox-first execution</h3>
        <p>Every shell call runs under bubblewrap on Linux — network denied, filesystem scoped. A compromised agent can't exfiltrate or destroy.</p>
      </article>
      <article>
        <div class="tilde-speed-card-meta"><span>02</span><small>Available now</small></div>
        <h3>Explicit approvals</h3>
        <p>You see the exact command, the reason, and choose [y]es, [n]o, or [a]lways-this-session. Nothing runs without your say.</p>
      </article>
      <article>
        <div class="tilde-speed-card-meta"><span>03</span><small>Available now</small></div>
        <h3>Workflow-native</h3>
        <p>See the plan, active work, tool activity, tests, and delegated tasks without reading a wall of chat.</p>
      </article>
    </div>
  </section>

  <section class="tilde-permissions reveal" aria-labelledby="permissions-title">
    <div class="tilde-permissions-head">
      <p class="tilde-label">Permissions</p>
      <h2 id="permissions-title">Every action lands on the ladder.</h2>
      <p>
        deny, ask, or allow — three tiers evaluated in order, with deny winning in every mode. Asks
        show the literal command and its reason; you answer with one key.
      </p>
    </div>
    <div class="tilde-tier-table" role="table" aria-label="tilde permission tiers">
      <div class="tilde-tier-head" aria-hidden="true"><span></span><span>Tier</span><span>What it means</span></div>
      {tiers.map((tier) => (
        <div class={`tilde-tier ${tier.slug}`}>
          <span class="tilde-tier-glyph" aria-hidden="true">{tier.glyph}</span>
          <span class="tilde-tier-name">{tier.name}<small>{tier.sub}</small></span>
          <p class="tilde-tier-desc">{tier.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="tilde-models reveal" aria-labelledby="models-title">
    <div class="tilde-models-heading">
      <p class="tilde-label">Models</p>
      <h2 id="models-title">Use the best model for the job.</h2>
      <p>
        Connect Ollama, OpenAI, Anthropic, Gemini, OpenRouter, or OpenCode. Switch models for the active provider
        from the terminal without changing how tilde works.
      </p>
    </div>
    <div class="tilde-provider-grid" aria-label="Supported model providers">
      {providers.map((provider) => (
        <article>
          <div class={`tilde-provider-logo tilde-provider-${provider.slug}`} aria-hidden="true">{provider.name[0]}</div>
          <div><strong>{provider.name}</strong><small>{provider.detail}</small></div>
        </article>
      ))}
    </div>
    <p class="tilde-model-note">
      Model availability and names come from provider APIs and can change. tilde passes your configured
      model ID to the active provider.
    </p>
  </section>
  <section class="tilde-intro reveal" aria-labelledby="difference-title">
    <h2 id="difference-title">Follow the work from issue to merge.</h2>
    <p>
      tilde inspects the issue, isolates the work, changes code, runs tests, opens the pull request,
      and responds to feedback — all in one visible workflow.
    </p>
  </section>

  <section class="tilde-principles reveal" aria-label="tilde principles">
    <article>
      <span>01</span>
      <h3>Works in the real repository</h3>
      <p>Start with the code, git state, project instructions, and tools your team already uses.</p>
    </article>
    <article>
      <span>02</span>
      <h3>Proves the change</h3>
      <p>Keep tests, builds, diff review, CI, and feedback inside the same visible workflow.</p>
    </article>
    <article>
      <span>03</span>
      <h3>Follows your rules</h3>
      <p>Load AGENTS.md, reusable skills, and optional tool confirmations for the way your team works.</p>
    </article>
  </section>

  <section class="tilde-orchestration reveal" aria-labelledby="orchestration-title">
    <div class="tilde-orchestration-copy">
      <p class="tilde-label">Focused delegation</p>
      <h2 id="orchestration-title">One coordinator. Focused workers.</h2>
      <p>
        tilde starts fresh subagents on focused parts of a task and returns their findings to one
        coordinator — ownership visible, runtime bounded.
      </p>
      <a class="tilde-text-link" href="/docs/architecture/">How the agent loop works <span aria-hidden="true">→</span></a>
    </div>
    <DemoWorkflow {...agentWorkflow} />
  </section>

  <section class="tilde-foundation reveal" aria-labelledby="foundation-title">
    <div>
      <h2 id="foundation-title">One Go binary. No runtime to install.</h2>
    </div>
    <dl>
      <div><dt>Built-in tools</dt><dd>Read, search, edit, write, and run shell commands without adding plugins.</dd></div>
      <div><dt>Hash-pinned plugins</dt><dd>Extend with skills, hooks, and MCP servers from sources you trust.</dd></div>
      <div><dt>Local sessions</dt><dd>Resume or search past work from session files stored on your disk.</dd></div>
      <div><dt>Open source</dt><dd>Read the code that runs commands and edits files in your repository.</dd></div>
      <div><dt>No telemetry</dt><dd>tilde does not send product analytics from your machine.</dd></div>
    </dl>
  </section>

  <section class="tilde-final reveal" aria-labelledby="final-title">
    <p class="tilde-label">tilde Harness</p>
    <h2 id="final-title">Try tilde in a real repository.</h2>
    <p>Install the binary, connect a model provider, and run <code>tilde</code>.</p>
    <div class="tilde-actions">
      <a class="tilde-button tilde-button-primary" href="https://github.com/Chmgx81/tilde">Install tilde</a>
      <a class="tilde-text-link" href="/docs/plan/">Read the build plan <span aria-hidden="true">→</span></a>
    </div>
  </section>
</div>

<script>
  const button = document.querySelector('[data-copy-install]');
  const copyStatus = document.querySelector('[data-copy-status]');

  const copyText = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const input = document.createElement('textarea');
      input.value = text;
      input.setAttribute('readonly', '');
      input.style.position = 'fixed';
      input.style.opacity = '0';
      document.body.append(input);
      input.select();
      const copied = document.execCommand('copy');
      input.remove();
      return copied;
    }
  };

  button?.addEventListener('click', async () => {
    const command = button.getAttribute('data-command') ?? '';
    if (await copyText(command)) {
      button.classList.add('copied');
      button.setAttribute('aria-label', 'Install command copied');
      if (copyStatus) copyStatus.textContent = 'Install command copied.';
      window.setTimeout(() => {
        button.classList.remove('copied');
        button.setAttribute('aria-label', 'Copy install command');
        if (copyStatus) copyStatus.textContent = '';
      }, 1800);
    } else {
      button.setAttribute('aria-label', 'Copy failed. Select the command manually.');
      if (copyStatus) copyStatus.textContent = 'Copy failed. Select the command manually.';
    }
  });

  // Scroll reveal: sections fade up once on entry (transform + opacity
  // only, GPU-cheap). Respects prefers-reduced-motion via the matching
  // CSS override — no JS media check needed.
  const revealed = document.querySelectorAll('.tilde-home .reveal');
  if ('IntersectionObserver' in window && revealed.length > 0) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      }
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    revealed.forEach((el) => io.observe(el));
  } else {
    revealed.forEach((el) => el.classList.add('in'));
  }
</script>
