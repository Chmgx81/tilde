---
type WorkflowItem = {
  label: string;
  detail: string;
  status?: 'active' | 'done';
};

type AgentRow = {
  number: string;
  label: string;
  status: string;
  statusClass?: string;
};

type Props = {
  variant: 'product' | 'agents';
  project?: string;
  progress?: string;
  mode?: string;
  request?: string;
  items?: WorkflowItem[];
  agent?: {
    glyph: string;
    label: string;
    detail: string;
  };
  proof?: {
    command: string;
    elapsed: string;
  };
  coordinator?: {
    task: string;
    status: string;
  };
  rows?: AgentRow[];
  note?: string;
};

const props = Astro.props as Props;
---

{props.variant === 'product' && (
  <div class="tilde-workflow tilde-card" role="group" aria-label="Example tilde workflow">
    <div class="tilde-window-bar" aria-hidden="true">
      <span></span><span></span><span></span>
      <em>tilde — plan · build · test · ship</em>
      <i class="tilde-live">live</i>
    </div>
    <div class="tilde-workflow-top">
      <span>{props.project}</span>
      <span class="tilde-mode"><i class="tilde-status-dot"></i> {props.mode}</span>
    </div>
    <div class="tilde-request">
      <span aria-hidden="true">→</span>
      <p>{props.request}<span class="tilde-cursor" aria-hidden="true"></span></p>
    </div>
    <div class="tilde-plan">
      <div class="tilde-plan-meta">
        <span>Plan</span>
        <span>{props.progress}</span>
      </div>
      <ol>
        {props.items?.map((item) => (
          <li
            class={item.status === 'done' ? 'done' : item.status === 'active' ? 'active' : undefined}
            aria-current={item.status === 'active' ? 'step' : undefined}
          >
            <span class="tilde-check" aria-hidden="true">{item.status === 'done' ? '✓' : item.status === 'active' ? <i class="tilde-status-dot"></i> : '○'}</span>
            <div>
              <strong>{item.label}</strong>{item.detail && <small>{item.detail}</small>}
              <span class="sr-only">{item.status === 'done' ? 'complete' : item.status === 'active' ? 'in progress' : 'pending'}</span>
              {item.status === 'active' && props.agent && (
                <div class="tilde-agent">
                  <span class="tilde-agent-glyph" aria-hidden="true">{props.agent.glyph}</span>
                  <span>{props.agent.label}</span>
                  <span>{props.agent.detail}</span>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
    {props.proof && <div class="tilde-proof"><span aria-hidden="true">✓</span><code>{props.proof.command}</code><small>{props.proof.elapsed}</small></div>}
  </div>
)}

{props.variant === 'agents' && (
  <div class="tilde-agents tilde-tree" role="group" aria-label="Example delegated work">
    {props.coordinator && (
      <div class="tilde-tree-root">
        <span class="tilde-row-glyph" aria-hidden="true">●</span>
        <strong>{props.coordinator.task}</strong>
        <small>{props.coordinator.status}</small>
      </div>
    )}
    <div class="tilde-tree-bus" aria-hidden="true"></div>
    <div class="tilde-tree-workers">
      {props.rows?.map((row) => (
        <div class="tilde-worker">
          <span class="tilde-row-glyph" aria-hidden="true">{row.number}</span>
          <strong>{row.label}</strong>
          <span class={`tilde-row-status ${row.statusClass ?? ''}`}><i class="tilde-status-glyph" aria-hidden="true">{row.status === 'complete' ? '✓' : row.status === 'working' ? '⋯' : '○'}</i>{row.status}</span>
        </div>
      ))}
    </div>
    {props.note && <p>{props.note}</p>}
  </div>
)}
