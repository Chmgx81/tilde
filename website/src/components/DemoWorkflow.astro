---
type TodoState = {
  text: string;
  state: 'active' | 'done' | 'pending';
};

type ToolCall = {
  verb: string;
  target: string;
  result?: string;
};

type AgentRow = {
  number: string;
  label: string;
  status: string;
  statusClass?: string;
};

type Props = {
  variant: 'product' | 'agents';
  request?: string;
  header?: string;
  welcomeTitle?: string;
  welcomeLines?: string[];
  budget?: string;
  sandbox?: string;
  modeTab?: string;
  modeNote?: string;
  thought?: string;
  todos?: TodoState[];
  tools?: ToolCall[];
  composer?: string;
  statusMode?: string;
  statusWhere?: string;
  statusRight?: string;
  hints?: string;
  coordinator?: {
    task: string;
    status: string;
  };
  rows?: AgentRow[];
  note?: string;
};

const props = Astro.props as Props;
---

{props.variant === 'product' && (
  <div class="tilde-workflow tilde-card" role="group" aria-label="Example tilde session">
    <div class="tilde-window-bar" aria-hidden="true">
      <span class="tilde-window-mark">~</span>
      <em>tilde · plan · build · test · ship</em>
    </div>
    <p class="tilde-term-head" aria-hidden="true">{props.header}</p>
    <div class="tilde-welcome" aria-hidden="true">
      <strong>{props.welcomeTitle}</strong>
      {props.welcomeLines?.map((line) => <p>{line}</p>)}
    </div>
    <div class="tilde-budgetrow" aria-hidden="true">
      <span>{props.budget}</span>
      <span>{props.sandbox}</span>
    </div>
    <div class="tilde-modebanner" aria-hidden="true">
      <span class="tilde-modebanner-tab">{props.modeTab}</span>
      <p>{props.modeNote}</p>
    </div>
    <div class="tilde-request">
      <span aria-hidden="true">→</span>
      <p>{props.request}<span class="tilde-cursor" aria-hidden="true"></span></p>
    </div>
    <p class="tilde-thought" aria-hidden="true"><span>◆</span> {props.thought}</p>
    <div class="tilde-todos">
      <p class="tilde-todos-head"><span aria-hidden="true">●</span> Update Todos</p>
      <ol>
        {props.todos?.map((todo) => (
          <li
            class={todo.state}
            aria-current={todo.state === 'active' ? 'step' : undefined}
          >
            <span class="tilde-tick" aria-hidden="true">{todo.state === 'done' ? '☑' : '□'}</span>
            <span>{todo.text}</span>
            <span class="sr-only">{todo.state === 'done' ? 'complete' : todo.state === 'active' ? 'in progress' : 'pending'}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="tilde-timeline" role="group" aria-label="Tool activity">
      {props.tools?.map((tool) => (
        <>
          <p class="tilde-tool">
            <span class="tilde-verb" aria-hidden="true">●</span>
            <strong>{tool.verb}</strong>
            <code>{tool.target}</code>
          </p>
          {tool.result && (
            <p class="tilde-tool-result">
              <span aria-hidden="true">⎿</span>
              <code>{tool.result}</code>
            </p>
          )}
        </>
      ))}
      <p class="tilde-done"><span aria-hidden="true">✓</span> Done</p>
    </div>
    <div class="tilde-composer" aria-hidden="true">
      <span>→</span>
      <span>{props.composer}</span>
    </div>
    <div class="tilde-statusbar" aria-hidden="true">
      <span class="tilde-status-left"><strong>{props.statusMode}</strong> · {props.statusWhere}</span>
      <span class="tilde-status-right">{props.statusRight}</span>
    </div>
    <p class="tilde-hintbar" aria-hidden="true">{props.hints}</p>
  </div>
)}

{props.variant === 'agents' && (
  <div class="tilde-agents tilde-tree" role="group" aria-label="Example delegated work">
    {props.coordinator && (
      <div class="tilde-tree-root">
        <span class="tilde-row-glyph" aria-hidden="true">●</span>
        <strong>{props.coordinator.task}</strong>
        <small>{props.coordinator.status}</small>
      </div>
    )}
    <div class="tilde-tree-bus" aria-hidden="true"></div>
    <div class="tilde-tree-workers">
      {props.rows?.map((row) => (
        <div class="tilde-worker">
          <span class="tilde-row-glyph" aria-hidden="true">{row.number}</span>
          <strong>{row.label}</strong>
          <span class={`tilde-row-status ${row.statusClass ?? ''}`}><i class="tilde-status-glyph" aria-hidden="true">{row.status === 'complete' ? '✓' : row.status === 'working' ? '⋯' : '○'}</i>{row.status}</span>
        </div>
      ))}
    </div>
    {props.note && <p>{props.note}</p>}
  </div>
)}
